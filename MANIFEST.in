include LICENSE
include README.md
include CHANGELOG.md
recursive-include src/phytclust/gui/static *
recursive-include src/phytclust/gui/templates *

prune site
global-exclude .ipynb_checkpoints
global-exclude *.pyc
global-exclude __pycache__

# Keep local analysis data and generated outputs out of release archives.
prune clonetrac
prune avian_peaks
prune figs_supp
prune manuscript_check
prune review_artifacts
prune results
prune tests
